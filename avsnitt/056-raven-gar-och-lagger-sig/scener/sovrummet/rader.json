-hej-raven",1.78,"Hej, räven! Hej, hej!"],["05-borstat-tanderna",1.18,"Har du borstat tänderna?"],["06-ja-vad-bra",0.83,"Ja, vad bra!"],["07-det-ar-kvall",2.94,"Det är kväll nu. Snart ska räven sova."],["08-dar-ar-nallen",1.37,"Och där är nallen!"],["09-ska-nallen-sova",1.6,"Ska nallen också sova?"],["10-ja-sa-klart",1.41,"Ja, så klart!"],["11-upp-i-sangen",1.78,"Räven hoppar upp i sängen!"],["12-kramar-nallen",3.48,"Mmm … räven kramar nallen."],["13-vad-mjuk",2.14,"Åh, vad mjuk nallen är!"],["14-slacker-lampan",1.49,"Nu släcker vi lampan."],["15-sa-morkt",5.28,"Oj! Så mörkt! Räven ser ingenting."],["16-tycker-inte-om",3.3,"Räven tycker inte om när det är så mörkt."],["17-det-forstar-jag",1.82,"Nej, det förstår jag."],["18-vad-gor-vi-nu",2.84,"Hm … räven vill ha lite ljus."],["19-kritan-ritar-nagot",2.87,"Titta! Kritan ritar något."],["20-en-lampa",0.98,"En lampa!"],["21-for-liten",3.25,"Klick … oj, lampan är för liten!"],["22-ritar-igen",2.23,"Kritan ritar en ny lampa."],["23-for-stor",4.66,"Klick … oj, lampan är för stor! Så ljust!"],["24-bort-med-den",2.19,"Kritan suddar bort den stora lampan."],["25-en-gang-till",1.7,"Kritan ritar en lampa till …"],["26-lagom",2.55,"Klick … nu är lampan lagom!"],["27-varsagod",1.31,"Varsågod, räven."],["28-sa-fint",3.09,"Oj, vad fint lampan lyser!"],["29-ska-vi-saga-tack",1.22,"Ska vi säga tack?"],["30-tack",0.69,"Tack!"],["31-titta-pa-vaggen",3.08,"Oj! Titta, en skugga på väggen!"],["32-stor-rav",2.33,"En stor räv på väggen!"],["33-liten-rav",2,"Och en liten räv på väggen!"],["34-tycker-du",4.11,"Jaså, tycker du att skuggan är rolig? Mm, jag också."],["35-var-ar-nallen",4.8,"Oj, var är nallen? Räven vet inte var."],["36-ser-du-nallen",3.38,"Kan du hjälpa räven? Ser du nallen?"],["37-ja-dar",2.43,"Ja, där! Under täcket!"],["38-dar-ar-nallen-igen",1.32,"Där är nallen!"],["39-lilla-lampan",3,"Och den lilla lampan … den får nallen!"],["40-lysa-hela-natten",2.44,"Lampan får lysa hela natten."],["41-ar-du-somnig",1.16,"Är du sömnig nu?"],["42-det-horde-jag",3.49,"Ja, räven gäspar! Det hörde jag!"],["43-hej-da-raven",3.1,"Hej då, räven! Hej då, nallen!"],["44-vi-ses-snart",3.68,"Hej då! Vi ses snart!"]]}