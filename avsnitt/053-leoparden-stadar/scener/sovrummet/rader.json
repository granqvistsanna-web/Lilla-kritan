itar", 1.88, "Kritan ritar …"], ["02-vad-blir-det", 2, "Hm … vad ritar kritan?"], ["03-en-trekant", 2.47, "Oj! En trekant!"], ["04-hej-leoparden", 2.03, "Hej, leoparden! Hej, hej!"], ["05-lekt-med-klossarna", 1.44, "Har du lekt med klossarna?"], ["06-ja-vad-kul", 1.46, "Ja, vad kul!"], ["07-oj-klossar-overallt", 3.36, "Oj, oj, oj! Klossar överallt!"], ["08-en-cirkel", 1.18, "En cirkel …"], ["09-en-fyrkant", 1.33, "en fyrkant …"], ["10-och-en-trekant", 1.19, "och en trekant!"], ["11-ska-vi-stada", 1.71, "Ska vi städa undan klossarna?"], ["12-ja-bra-ide", 1.48, "Ja, bra idé!"], ["13-oj-da", 2.67, "Oj då! Cirkeln trillade ner."], ["14-korgen-ar-full", 1.28, "Korgen är full."], ["15-far-inte-plats", 2.25, "Klossarna får inte plats i korgen."], ["16-inte-sa-latt", 3.2, "Nej, fyrkanten trillade också ner."], ["17-vad-gor-vi-nu", 2.21, "Hm … var ska klossarna vara?"], ["18-kritan-ritar-nagot", 2.83, "Titta! Kritan ritar något till klossarna."], ["19-en-lada", 2.71, "En låda! Med tre hål."], ["20-varsagod", 3.4, "Varsågod, leoparden. Lådan är till klossarna."], ["21-tycker-du-om-ladan", 1.26, "Tycker du om lådan?"], ["22-den-ar-sa-fin", 2.11, "Ja, den är så fin!"], ["23-ska-vi-saga-tack", 1.3, "Ska vi säga tack?"], ["24-tack-kritan", 1.1, "Tack, kritan!"], ["25-vad-ska-du-gora", 1.87, "Vad ska du göra med trekanten?"], ["26-oj-en-hatt", 2.88, "Oj! Trekanten blev en hatt!"], ["27-en-spetsig-hatt", 1.69, "En spetsig hatt!"], ["28-hoppsan", 2.65, "Hoppsan! Hatten ramlade av."], ["29-forst-cirkeln", 2.79, "Nu städar vi. Först cirkeln."], ["30-inte-dar", 2.47, "Hm … cirkeln passar inte där."], ["31-ner-i-halet-1", 3.7, "Cirkeln ner i det runda hålet … plopp!"], ["32-dar-passade-den", 2.03, "Ja, cirkeln passade!"], ["33-och-fyrkanten", 1.68, "Nu tar du fyrkanten."], ["34-ner-i-halet-2", 4.4, "Fyrkanten ner i det fyrkantiga hålet … plopp!"], ["35-var-ar-trekanten", 5.98, "Och nu trekanten … Oj! Var är trekanten?"], ["36-vet-inte-var", 1.77, "Leoparden vet inte var."], ["37-kan-du-hjalpa", 4.26, "Kan du hjälpa leoparden? Kan du se var trekanten är?"], ["38-ja-dar", 2.45, "Ja, där! Bakom kaktusen!"], ["39-ner-i-halet-3", 4.4, "Trekanten ner i det trekantiga hålet … plopp!"], ["40-nu-ar-det-statat", 1.36, "Nu är det städat!"], ["41-alla-i-ladan", 5.33, "Cirkeln, fyrkanten och trekanten. Alla i lådan."], ["42-det-skramlar", 2.22, "Hör du? Det skramlar!"], ["43-kul-att-stada", 1.3, "Var det kul att städa?"], ["44-tyckte-jag-ocksa", 1.9, "Ja, det tyckte jag också!"], ["45-hej-da-leoparden", 3.01, "Hej då, leoparden! Hej då, klossarna!"], ["46-vi-ses-snart", 1.95, "Hej då! Vi ses snart!"]]}